  "definitions": {
    "palaceRef": {"type":"object","additionalProperties":false,"required":["palace_id","name","branch"],"properties":{"palace_id":{"type":"string"},"name":{"type":"string"},"branch":{"type":"string"}}},
    "brightness": {"type":"object","additionalProperties":false,"required":["raw_state","source","provider","table_version","semantic_consumption"],"properties":{"raw_state":{"type":["string","null"]},"source":{"const":"SOURCE_STAR_PHYSICAL_CONTEXT"},"provider":{"const":"iztro"},"table_version":{"const":"2.5.8"},"semantic_consumption":{"const":"OFF"}}},
    "star": {"type":"object","additionalProperties":false,"required":["star_id","name","category","raw_type","scope","physical_palace_id","physical_palace_name","natal_transform","brightness","source_identity"],"properties":{"star_id":{"type":"string"},"name":{"type":"string"},"category":{"enum":["MAIN","AUXILIARY","MISCELLANEOUS"]},"raw_type":{"type":["string","null"]},"scope":{"type":["string","null"]},"physical_palace_id":{"type":"string"},"physical_palace_name":{"type":"string"},"natal_transform":{"type":["string","null"],"enum":["LU","QUAN","KE","JI",null]},"brightness":{"$ref":"#/definitions/brightness"},"source_identity":{"type":"object","additionalProperties":false,"required":["physical_palace_id","source_star_id","relocated"],"properties":{"physical_palace_id":{"type":"string"},"source_star_id":{"type":"string"},"relocated":{"const":false}}}}},
    "palace": {"type":"object","additionalProperties":false,"required":["palace_id","physical_index","name","stem","branch","is_life_palace","is_body_palace","local_main_tone_status","main_stars","auxiliary_stars","miscellaneous_stars"],"properties":{"palace_id":{"type":"string"},"physical_index":{"type":"integer","minimum":0,"maximum":11},"name":{"type":"string"},"stem":{"type":"string"},"branch":{"type":"string"},"is_life_palace":{"type":"boolean"},"is_body_palace":{"type":"boolean"},"local_main_tone_status":{"enum":["PRESENT","PENDING_EMPTY"]},"main_stars":{"type":"array","items":{"$ref":"#/definitions/star"}},"auxiliary_stars":{"type":"array","items":{"$ref":"#/definitions/star"}},"miscellaneous_stars":{"type":"array","items":{"$ref":"#/definitions/star"}}}},
    "opposite": {"type":"object","additionalProperties":false,"required":["target_palace_id","opposite_palace_id","evidence_role"],"properties":{"target_palace_id":{"type":"string"},"opposite_palace_id":{"type":"string"},"evidence_role":{"const":"OPPOSITE"}}},
    "sanfang": {"type":"object","additionalProperties":false,"required":["target_palace_id","sanhe_palace_ids","evidence_role"],"properties":{"target_palace_id":{"type":"string"},"sanhe_palace_ids":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string"}},"evidence_role":{"const":"SANHE"}}},
    "borrow": {"type":"object","additionalProperties":false,"required":["target_palace_id","eligible","reason","source_palace_id","borrowed_main_star_ids","borrow_rule","local_facts_remain_active","relocation"],"properties":{"target_palace_id":{"type":"string"},"eligible":{"type":"boolean"},"reason":{"type":"string"},"source_palace_id":{"type":["string","null"]},"borrowed_main_star_ids":{"type":"array","items":{"type":"string"}},"borrow_rule":{"const":"COMPLETE_OPPOSITE_MAIN_TONE_GROUP"},"local_facts_remain_active":{"const":true},"relocation":{"const":false}}},
    "decade": {"type":"object","additionalProperties":false,"required":["palace_id","range","stem","branch"],"properties":{"palace_id":{"type":"string"},"range":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer"}},"stem":{"type":"string"},"branch":{"type":"string"}}}
  }
}
