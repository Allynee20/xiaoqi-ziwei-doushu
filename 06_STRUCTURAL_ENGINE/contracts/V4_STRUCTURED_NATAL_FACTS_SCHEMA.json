    "palaces": {"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/definitions/palace"}},
    "relationships": {"type":"object","additionalProperties":false,"required":["opposites","sanfang"],"properties":{"opposites":{"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/definitions/opposite"}},"sanfang":{"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/definitions/sanfang"}}}},
    "borrow_eligibility": {"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/definitions/borrow"}},
    "decade_data": {"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/definitions/decade"}},
    "excluded_runtime_fields": {"type":"array","items":{"type":"string"}}
