        "brightness_semantic_consumption":{"const":"OFF"},
        "small_limit":{"const":"OFF"},
        "flying_transform":{"const":"OFF"},
        "dtr":{"const":"OFF"}
      }
    },
    "calendar_facts": {"type":"object","additionalProperties":false,"required":["gender","solar_date","lunar_date","chinese_date","raw_dates","time_branch","time_range"],"properties":{"gender":{"type":"string"},"solar_date":{"type":"string"},"lunar_date":{"type":"string"},"chinese_date":{"type":"string"},"raw_dates":{"type":"object"},"time_branch":{"type":"string"},"time_range":{"type":"string"}}},
